@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Administración</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="~/css/site.css" />
  <style>
    .admin-wrap{display:grid;grid-template-columns:260px 1fr;gap:24px;min-height:80vh}
    .admin-aside{background:var(--bg-2);border-radius:var(--radius);padding:16px}
    .admin-aside a{display:block;padding:.7rem 1rem;border-radius:10px;margin-bottom:6px;text-decoration:none}
    .admin-aside a:hover{background:var(--bg-3)}
    .admin-main{background:var(--bg-2);border-radius:var(--radius);padding:20px}
  </style>
</head>
<header class="nav">
  <div class="container nav-wrap">
    <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"
       style="display:flex; align-items:center; gap:1px;">
      <img src="~/img/Inicio/logo_horizontal-diaples.gif"
           alt="Logo Os Diaples d'a Uerba"
           style="height:50px; width:auto; border-radius:8px;" />
    </a>

    <!-- Toggle móvil -->
    <input id="nav-toggle" type="checkbox" class="nav-toggle" />
    <label for="nav-toggle" class="hamburger" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <!-- Menú -->
    <nav class="nav-menu">
      <div class="nav-links">
        <a asp-area="" asp-controller="Home" asp-action="About">Os Diaples</a>
        <a asp-area="" asp-controller="Home" asp-action="Espectaculos">Espectáculos</a>
        <a asp-area="" asp-controller="Home" asp-action="Galeria">Galería</a>
        <a asp-area="" asp-controller="Home" asp-action="Contact">Contacto</a>
      </div>

      <!-- Acciones (login/registro/logout) -->
      <div class="nav-actions">
        <partial name="_LoginPartial" />
      </div>
    </nav>
  </div>
</header>


<body>
<div class="container admin-wrap">
  <aside class="admin-aside">
    <h3 style="margin-bottom:10px">Panel</h3>
<aside class="admin-aside">
  <h3>Panel</h3>
        <a href="~/Admin/Users">Usuarios</a>
        <a href="~/Admin/Messages">Mensajes</a>
        <a href="~/Admin/Events/Index">Eventos</a>
</aside>

  </aside>
  <main class="admin-main">
    @RenderBody()
  </main>
</div>
@RenderSection("Scripts", required: false)
</body>
</html>

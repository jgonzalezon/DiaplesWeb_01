@using System.Collections.Generic
@using System.Text.Json
@model List<(Microsoft.AspNetCore.Identity.IdentityUser User, System.Collections.Generic.IList<string> Roles)>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["PageTitle"];
    var textsJson = JsonSerializer.Serialize(new
    {
        processing = Localizer["Processing"].Value,
        userCreated = Localizer["UserCreated"].Value,
        operationDone = Localizer["OperationCompleted"].Value,
        roleChanged = Localizer["RoleChangedTemplate"].Value,
        userDeleted = Localizer["UserDeleted"].Value,
        confirmDeleteUser = Localizer["ConfirmDeleteUser"].Value,
        operationFailed = Localizer["OperationFailedTemplate"].Value,
        passwordHintDefault = Localizer["PasswordHint"].Value,
        passwordStrength = new
        {
            weak = Localizer["PasswordStrengthWeak"].Value,
            fair = Localizer["PasswordStrengthFair"].Value,
            good = Localizer["PasswordStrengthGood"].Value,
            strong = Localizer["PasswordStrengthStrong"].Value
        }
    });
    var roleLabelsJson = JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["User"] = Localizer["RoleOptionUser"].Value,
        ["Admin"] = Localizer["RoleOptionAdmin"].Value
    });
}
<section class="admin-card">
  <div class="section-header">
    <h2 class="section-title m-0">@Localizer["Heading"]</h2>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">@Localizer["BackButton"]</a>
  </div>

  <!-- Sección: Crear usuario -->
  <div class="admin-section">
    <h5 class="text-muted mb-2">@Localizer["CreateUserHeading"]</h5>

    <form id="createForm"
          method="post"
          asp-area="Admin" asp-controller="Users" asp-action="Create"
          class="form">
      @Html.AntiForgeryToken()

      <div class="form-grid">
        <div class="form-field">
          <label for="userName">@Localizer["UserLabel"]</label>
          <input id="userName" name="userName" placeholder="@Localizer["UserPlaceholder"]" required />
        </div>

        <div class="form-field">
          <label for="role">@Localizer["RoleLabel"]</label>
          <select id="role" name="role">
              <option value="User" selected>@Localizer["RoleOptionUser"]</option>
              <option value="Admin">@Localizer["RoleOptionAdmin"]</option>
          </select>
        </div>

        <div class="form-field">
          <label for="email">@Localizer["EmailLabel"]</label>
          <input id="email" name="email" type="email" placeholder="@Localizer["EmailPlaceholder"]" required />
        </div>

        <div class="form-field">
          <label for="pwd">@Localizer["PasswordLabel"]</label>

          <input name="password" id="pwd" type="password" placeholder="@Localizer["PasswordPlaceholder"]" required />

          <div class="mt-2" role="group" aria-label="@Localizer["PasswordActionsAria"]">
            <button type="button" class="btn btn-primary-like btn-pill-left" id="btnTogglePwd" title="@Localizer["TogglePasswordTitle"]">
              @Localizer["TogglePasswordButton"]
            </button>
            <button type="button" class="btn btn-primary-like btn-pill-right" id="btnGenPwd" title="@Localizer["GeneratePasswordTitle"]">
              @Localizer["GeneratePasswordButton"]
            </button>
          </div>

          <div class="progress mt-2" style="height:6px;">
            <div class="progress-bar" id="pwdMeter" role="progressbar" style="width:0%"></div>
          </div>
          <div class="form-text" id="pwdHint">@Localizer["PasswordHint"]</div>
        </div>


        <div class="form-field form-field--full">
          <button class="btn btn-primary-like" id="btnCreate">@Localizer["CreateButton"]</button>
        </div>

        <div class="form-field form-field--full">
          <div id="createMsg"></div>
        </div>
      </div>
    </form>
  </div>

  <!-- Sección: Tabla de usuarios -->
  <div class="admin-section">
    <h5 class="text-muted mb-2">@Localizer["ListHeading"]</h5>
    <div id="usersTable">
      @await Html.PartialAsync("_UsersTable", Model)
    </div>
  </div>
</section>

@section Scripts {
<script>
(function () {
  // ---- Elementos base
  var usersTable   = document.getElementById('usersTable');
  var formCreate   = document.getElementById('createForm');
  var msgCreate    = document.getElementById('createMsg');

  const texts = @Html.Raw(textsJson);
  const roleLabels = @Html.Raw(roleLabelsJson);

  // Controles de password (si existen)
  var btnGenPwd    = document.getElementById('btnGenPwd');
  var btnTogglePwd = document.getElementById('btnTogglePwd');
  var pwd          = document.getElementById('pwd');
  var meter        = document.getElementById('pwdMeter');
  var hint         = document.getElementById('pwdHint');

  // ---- Utilidades UI
  function toast(text){
    if (msgCreate) msgCreate.innerHTML =
      '<div class="alert alert-success py-2 my-2">' + text + '</div>';
  }
  function error(text){
    if (msgCreate) msgCreate.innerHTML =
      '<div class="alert alert-danger  py-2 my-2">' + text + '</div>';
  }

  // postForm: deshabilita SOLO el botón del formulario enviado y muestra mensaje contextual
  async function postForm(f, opts) {
    var submitBtn = f.querySelector('button[type="submit"], button:not([type])');
    var prevText  = submitBtn ? submitBtn.innerText : '';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.innerText = texts.processing; }
    if (msgCreate) msgCreate.innerHTML = '';

    try {
      var resp = await fetch(f.action, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: new FormData(f)
      });
      if (!resp.ok) throw new Error('Error ' + resp.status);

      var html = await resp.text();
      usersTable.innerHTML = html;

      var successMessage = '';
      if (opts && opts.successText) {
        successMessage = (typeof opts.successText === 'function') ? opts.successText() : opts.successText;
      } else if (f === formCreate) {
        successMessage = texts.userCreated;
      } else {
        successMessage = texts.operationDone;
      }
      toast(successMessage);

      // Reset SOLO si era el formulario de creación
      if (f === formCreate) {
        formCreate.reset();
        var roleSelect = document.getElementById('role');
        if (roleSelect) roleSelect.value = 'User';
        if (meter) { meter.style.width = '0%'; meter.className = 'progress-bar'; }
        if (hint)  { hint.innerText = texts.passwordHintDefault; }
      }
    } catch (e) {
      error(texts.operationFailed.replace('{error}', e.message));
      console.error(e);
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.innerText = prevText; }
    }
  }

  // ---- Listeners

  // Crear usuario
  if (formCreate) {
    formCreate.addEventListener('submit', function (e) {
      e.preventDefault();
      postForm(e.target, { successText: texts.userCreated });
    });
  }

  // Guardar rol (delegación en tabla)
  if (usersTable) {
    usersTable.addEventListener('submit', function (e) {
      if (e.target.matches('form.roleForm')) {
        e.preventDefault();
        var roleVal = e.target.querySelector('select[name="role"]')?.value || '';
        var roleLabel = roleLabels[roleVal] || roleVal;
        postForm(e.target, { successText: texts.roleChanged.replace('{role}', roleLabel) });
      }
    });

    usersTable.addEventListener('submit', function (e) {
      if (e.target.matches('form.deleteForm')) {
        e.preventDefault();
        if (!confirm(texts.confirmDeleteUser)) return;
        postForm(e.target, { successText: texts.userDeleted });
      }
    });
  }

  // ---- Password: generar / mostrar-ocultar / medidor
  if (btnGenPwd && pwd) {
    btnGenPwd.addEventListener('click', function () {
      pwd.value = genPwd();
      updateStrength();
    });
  }
  if (btnTogglePwd && pwd) {
    btnTogglePwd.addEventListener('click', function () {
      pwd.type = (pwd.type === 'password') ? 'text' : 'password';
    });
  }
  if (pwd) {
    pwd.addEventListener('input', updateStrength);
  }

  function updateStrength() {
    if (!pwd || !meter || !hint) return;
    var s = score(pwd.value);
    meter.style.width = (s * 25) + '%';
    meter.className = 'progress-bar ' + (s <= 1 ? 'bg-danger' : (s === 2 ? 'bg-warning' : (s === 3 ? 'bg-info' : 'bg-success')));
    hint.innerText = (s <= 1 ? texts.passwordStrength.weak : (s === 2 ? texts.passwordStrength.fair : (s === 3 ? texts.passwordStrength.good : texts.passwordStrength.strong)));
  }
  function score(v) {
    var s = 0;
    if (v.length >= 6) s++;
    if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s++;
    if (/\d/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v) || v.length >= 12) s++;
    return Math.min(s, 4);
  }
  function genPwd() {
    var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!$%*?';
    var out = '';
    for (var i = 0; i < 12; i++) out += chars[Math.floor(Math.random() * chars.length)];
    return out;
  }
})();
</script>
}

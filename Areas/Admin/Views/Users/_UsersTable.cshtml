@model List<(Microsoft.AspNetCore.Identity.IdentityUser User, System.Collections.Generic.IList<string> Roles)>
@using System.Security.Claims

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

  <table class="table table-dark table-hover align-middle">
  <thead>
    <tr>
      <th style="width:20%">@Localizer["UsersTableUser"].Value</th>
      <th style="width:15%">@Localizer["UsersTablePhone"].Value</th>
      <th style="width:20%">@Localizer["UsersTableEmail"].Value</th>
      <th class="th-actions">@Localizer["UsersTableActions"].Value</th>
    </tr>
  </thead>
  <tbody>
@foreach (var item in Model)
{
    var user  = item.User;
    var roles = item.Roles;
    var currentRole = (roles != null && roles.Count > 0) ? roles[0] : "User";
    var isSelf = user.Id == currentUserId;
<tr>
  <td>
    @user.UserName
      @if (isSelf) { <span class="badge text-bg-secondary ms-2">@Localizer["UsersBadgeSelf"].Value</span> }
    </td>
    <td>@(user.PhoneNumber ?? "—")</td>
    <td>@user.Email</td>

    <td class="td-actions">
      <div class="user-actions">
        <!-- Cambiar rol -->
      <form method="post"
            asp-area="Admin"
            asp-controller="Users"
            asp-action="UpdateRole"
            class="form roleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@user.Id" />
          <select name="role" aria-label="@Localizer["UsersChangeRole"].Value" @(isSelf ? "disabled" : null)>
            <option value="User"  selected="@(currentRole == "User")">@Localizer["RoleUser"].Value</option>
            <option value="Admin" selected="@(currentRole == "Admin")">@Localizer["RoleAdmin"].Value</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary-like" @(isSelf ? "disabled" : null)>
            @Localizer["Save"].Value
          </button>
        </form>

        <!-- Borrar -->
        <form method="post"
            asp-area="Admin"
            asp-controller="Users"
            asp-action="Delete"
            class="deleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@user.Id" />
          <button type="submit" class="btn btn-sm btn-danger" @(isSelf ? "disabled" : null)>
            @Localizer["Delete"].Value
          </button>
        </form>
      </div>
    </td>
  </tr>
}
</tbody>
</table>

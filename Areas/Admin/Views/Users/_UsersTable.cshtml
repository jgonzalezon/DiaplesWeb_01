@model List<(Microsoft.AspNetCore.Identity.IdentityUser User, System.Collections.Generic.IList<string> Roles)>
@using System.Security.Claims

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<table class="table table-dark table-hover align-middle">
<thead>
  <tr>
    <th style="width:20%">Usuario</th>
    <th style="width:15%">Teléfono</th>
    <th style="width:20%">Email</th>
    <th class="th-actions">Rol / Acciones</th>
  </tr>
</thead>
<tbody>
@foreach (var item in Model)
{
    var user  = item.User;
    var roles = item.Roles;
    var currentRole = (roles != null && roles.Count > 0) ? roles[0] : "User";
    var isSelf = user.Id == currentUserId;
<tr>
  <td>
    @user.UserName
    @if (isSelf) { <span class="badge text-bg-secondary ms-2">Tú</span> }
  </td>
  <td>@(user.PhoneNumber ?? "—")</td>
  <td>@user.Email</td>

  <td class="td-actions">
    <div class="user-actions">
      <!-- Cambiar rol -->
      <form method="post"
            asp-area="Admin"
            asp-controller="Users"
            asp-action="UpdateRole"
            class="form roleForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@user.Id" />
        <select name="role" aria-label="Cambiar rol" @(isSelf ? "disabled" : null)>
          <option value="User"  selected="@(currentRole == "User")">User</option>
          <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary-like" @(isSelf ? "disabled" : null)>
          Guardar
        </button>
      </form>

      <!-- Borrar -->
      <form method="post"
            asp-area="Admin"
            asp-controller="Users"
            asp-action="Delete"
            class="deleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@user.Id" />
        <button type="submit" class="btn btn-sm btn-danger" @(isSelf ? "disabled" : null)>
          Borrar
        </button>
      </form>
    </div>
  </td>
</tr>
}
</tbody>
</table>

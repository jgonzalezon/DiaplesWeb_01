@model DiaplesWeb.Models.ContactMessage
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>@Model.Name <small style="color:var(--muted)">&lt;@Model.Email&gt;</small></h2>
<p><strong>Teléfono:</strong> @Model.Phone</p>
<p><strong>Fecha:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
<article style="white-space:pre-wrap;margin-top:12px">@Model.Message</article>

<div class="actions-row">
  <!-- Izquierda -->
  <a asp-area="Admin" asp-controller="Messages" asp-action="Index"
     class="btn btn-outline-light btn-action btn-volver">Volver</a>

  <!-- Derecha -->
  <form asp-area="Admin" asp-controller="Messages" asp-action="Delete"
        method="post" onsubmit="return confirm('¿Seguro que deseas borrar este mensaje?')">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger btn-action">Borrar</button>
  </form>
</div>


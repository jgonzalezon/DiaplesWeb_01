@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
}
<h1>Te hemos enviado un correo</h1>
<p>Revisa tu bandeja de entrada y haz clic en el enlace para confirmar tu cuenta.</p>

@if (Model.DisplayConfirmAccountLink)
{
    <p>Enlace de desarrollo: <a href="@Model.EmailConfirmationUrl">Confirmar ahora</a></p>
}

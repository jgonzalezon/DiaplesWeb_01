@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Correo enviado";
}

<section class="container" style="max-width:900px; margin:auto; padding-top:2rem; text-align:center;">
    <h1 class="section-title">@ViewData["Title"]</h1>

    <div class="card" style="margin-top:1.5rem; background:var(--bg-card); padding:2rem;">
        <p style="font-size:1.1rem; line-height:1.6;">
            Te hemos enviado un correo electrónico con las instrucciones para 
            <strong>reestablecer tu contraseña</strong>.
        </p>

        <p style="margin-top:0.75rem; color:var(--muted);">
            Si no lo encuentras en tu bandeja de entrada, revisa también la carpeta de spam o correo no deseado.
        </p>

        <div style="margin-top:2rem;">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn">Volver a iniciar sesión</a>
            <a  asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ghost">Ir a inicio</a>
        </div>
    </div>
</section>

@page
@model LoginModel

@{
    ViewData["Title"] = Localizer["LoginTitle"].Value;
}

<h1>@Localizer["LoginHeading"].Value</h1>
<div class="row justify-content-center my-4">
  <div class="col-12 col-md-10 col-lg-7 col-xxl-6">
    <div class="auth-card">
      <h2 class="mb-2">@Localizer["LoginHeading"].Value</h2>
      <p class="text-muted mb-3">@Localizer["LoginIntro"].Value</p>
      <hr class="hr-soft" />

      <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

        <div class="mb-3">
          <label asp-for="Input.Identifier" class="form-label">@Localizer["LoginIdentifierLabel"].Value</label>
          <input asp-for="Input.Identifier" class="form-control input-dark"
                autocomplete="username" placeholder="@Localizer["LoginIdentifierPlaceholder"].Value" />
          <span asp-validation-for="Input.Identifier" class="text-danger small"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Input.Password" class="form-label">@Localizer["Password"].Value</label>
          <input asp-for="Input.Password" class="form-control input-dark"
                autocomplete="current-password" placeholder="@Localizer["PasswordPlaceholder"].Value" />
          <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
          <input class="form-check-input" asp-for="Input.RememberMe" />
          <label class="form-check-label" asp-for="Input.RememberMe">@Localizer["RememberMe"].Value</label>
        </div>

        <button type="submit" class="btn btn-gradient w-100 mt-2">@Localizer["LoginButton"].Value</button>

        <div class="d-flex justify-content-between mt-3">
          <a id="forgot-password" asp-page="./ForgotPassword">@Localizer["ForgotPasswordLink"].Value</a>
          <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["RegisterLink"].Value</a>
        </div>
      </form>
    </div>
  </div>

  <!-- panel derecho del template (external logins) oculto -->
  <div class="col-lg-5 auth-hide-external"></div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}



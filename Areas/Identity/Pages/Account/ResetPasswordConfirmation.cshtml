@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña actualizada";
}

<section class="container" style="max-width:900px;margin:auto;">
  <h1>@ViewData["Title"]</h1>
  <div class="alert-success">Tu contraseña se ha actualizado correctamente.</div>
  <div style="margin-top:1rem;">
    <a asp-area="Identity" asp-page="/Account/Login" class="btn">Entrar</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">Volver a inicio</a>
  </div>
</section>

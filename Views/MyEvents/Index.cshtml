@model List<DiaplesWeb.Models.EventItem>
@{
    ViewData["Title"] = "Mis eventos";
    ViewData["BodyClass"] = "page-myevents";
    var myStatuses = ViewBag.MyStatuses as Dictionary<int, DiaplesWeb.Models.AttendanceStatus>;
}

<section class="my-events">
  <div class="grid-2col">
    <!-- Lista izquierda -->
    <aside class="panel-left">
      <h2 class="section-title">Mis eventos</h2>

      <div class="legend legend--attendance">
        <span class="legend-item"><i class="dot dot--yes"></i> Sí</span>
        <span class="legend-item"><i class="dot dot--maybe"></i> Pendiente</span>
        <span class="legend-item"><i class="dot dot--no"></i> No</span>
      </div>

      @if (TempData["ok"] is string ok)
      {
          <div class="alert-success">@ok</div>
      }

      @if (Model == null || !Model.Any())
      {
          <p class="muted">No hay eventos disponibles.</p>
      }
      else
      {
        <ul class="event-list">
          @foreach (var e in Model)
          {
              var current = myStatuses != null && myStatuses.TryGetValue(e.Id, out var s)
                            ? s : DiaplesWeb.Models.AttendanceStatus.No;
              var anchorId = $"event-{e.Id}";
              <li class="event-item" id="@anchorId">
                <div class="event-info">
                  <a class="event-title" asp-action="Details" asp-route-id="@e.Id">
                    <strong>@e.Title</strong>
                  </a>
                  <div class="meta">
                    <span class="date">@e.Date.ToString("dd/MM/yyyy HH:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(e.Location))
                    {
                      <span class="sep">·</span><span class="loc">@e.Location</span>
                    }
                  </div>
                  @if (!string.IsNullOrWhiteSpace(e.Description))
                  {
                    <p class="desc-clamp">@e.Description</p>
                  }
                </div>

                
                <form asp-action="UpdateMyAttendance" method="post" class="attendance-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@e.Id" />
            @{
                // Si current es nulo, usamos No por defecto
                var currentStr = current.ToString() ?? "No";
            }
            <select name="status" class="select-status">
            <option value="Yes" selected="@(currentStr == "Yes" ? "selected" : null)">Sí</option>
            <option value="Maybe" selected="@(currentStr == "Maybe" ? "selected" : null)">Pendiente</option>
            <option value="No" selected="@(currentStr == "No" ? "selected" : null)">No</option>
            </select>

                  <button type="submit" class="btn-sm">Guardar</button>
                </form>
              </li>
          }
        </ul>
      }
    </aside>

    <!-- Calendario -->
    <section class="panel-right">
      <h2 class="section-title">Calendario</h2>
      <div id="calendar"></div>
    </section>
  </div>
</section>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const calendarEl = document.getElementById('calendar');
      if (!calendarEl) return;

      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        height: 'auto',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        events: function (info, success, fail) {
          const url = '@Url.Action("CalendarFeed", "MyEvents")';
          const params = new URLSearchParams({ start: info.startStr, end: info.endStr });
          fetch(url + '?' + params, { credentials: 'include' })
            .then(r => r.json())
            .then(data => success(data))
            .catch(fail);
        },
        eventDidMount: function (info) {
          const loc = info.event.extendedProps?.location;
          if (loc) info.el.setAttribute('title', loc);
        },
        eventClick: function (info) {
          if (info.event.url) {
            window.location.href = info.event.url;
            info.jsEvent.preventDefault();
          }
        }
      });

      calendar.render();
    });
  </script>
}


@section Styles {
<style>
  /* ———  A. Layout: centrar y ampliar SOLO en MyEvents ——— */
  .page-myevents .page-content {
    /* el wrapper del layout se centra y se hace más ancho */
    max-width: 1200px;                 /* ⬅️ ajusta a tu gusto */
    width: min(92vw, 1200px);
    margin-inline: auto;
    padding-inline: 0;                 /* elimina padding lateral si lo tuviera */
    position: relative;
  }

  /* Si el layout usa otro contenedor interno, lo igualamos */
  .page-myevents .page-content > .container,
  .page-myevents .page-content > .content,
  .page-myevents .page-content > .content-frame,
  .page-myevents .page-content > .content-shell {
    max-width: inherit;
    width: 100%;
    margin-inline: auto;
  }

  /* Si el layout pinta un fondo oscuro con ::before, lo apagamos aquí */
  .page-myevents .page-content::before,
  .page-myevents .content-frame::before,
  .page-myevents .content-shell::before {
    background: transparent !important;
    box-shadow: none !important;
  }

  /* ———  B. Tu bloque MyEvents (fondo + grid) ——— */
  .my-events {
    max-width: 1100px;                 /* el tamaño que comentas */
    width: min(92vw, 1100px);
    margin-inline: auto;
    position: relative;
    padding: 16px;
  }
  .my-events::before{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: rgba(12,16,22,.72);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,.04),
      0 12px 40px rgba(0,0,0,.45);
    z-index: 0;
  }
  .my-events > *{ position: relative; z-index: 1; }

  /* Izquierda 0.5fr / derecha 1fr como tienes ahora */
  .my-events .grid-2col{
    display: grid;
    grid-template-columns: 0.5fr 1fr;
    gap: 2rem;
  }

  /* Botón debajo del select */
  .my-events .attendance-form{
    display: flex;
    flex-direction: column;
    gap: .5rem;
    align-items: flex-start;
  }


</style>
}
@model List<DiaplesWeb.Models.EventItem>
@{
    ViewData["Title"] = "Mis eventos";
    var myStatuses = ViewBag.MyStatuses as Dictionary<int, DiaplesWeb.Models.AttendanceStatus>;
}

<section class="my-events">
  <div class="grid-2col">
    <!-- Lista izquierda -->
    <aside class="panel-left">
      <h2 class="section-title">Mis eventos</h2>

      <div class="legend legend--attendance">
        <span class="legend-item"><i class="dot dot--yes"></i> Sí</span>
        <span class="legend-item"><i class="dot dot--maybe"></i> Pendiente</span>
        <span class="legend-item"><i class="dot dot--no"></i> No</span>
      </div>

      @if (TempData["ok"] is string ok)
      {
          <div class="alert-success">@ok</div>
      }

      @if (Model == null || !Model.Any())
      {
          <p class="muted">No hay eventos disponibles.</p>
      }
      else
      {
        <ul class="event-list">
          @foreach (var e in Model)
          {
              var current = myStatuses != null && myStatuses.TryGetValue(e.Id, out var s)
                            ? s : DiaplesWeb.Models.AttendanceStatus.No;
              var anchorId = $"event-{e.Id}";
              <li class="event-item" id="@anchorId">
                <div class="event-info">
                  <strong>@e.Title</strong>
                  <div class="meta">
                    <span class="date">@e.Date.ToString("dd/MM/yyyy HH:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(e.Location))
                    {
                      <span class="sep">·</span><span class="loc">@e.Location</span>
                    }
                  </div>
                   @* 👇 Descripción (resumen de 2 líneas) *@
                  @if (!string.IsNullOrWhiteSpace(e.Description))
                  {
                    <p class="desc-clamp">@e.Description</p>
                  }

                  <a class="link-details" asp-action="Details" asp-route-id="@e.Id">Ver detalles</a>
                </div>

                
                <form asp-action="UpdateMyAttendance" method="post" class="attendance-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@e.Id" />
            @{
                // Si current es nulo, usamos No por defecto
                var currentStr = current.ToString() ?? "No";
            }
            <select name="status" class="select-status">
            <option value="Yes" selected="@(currentStr == "Yes" ? "selected" : null)">Sí</option>
            <option value="Maybe" selected="@(currentStr == "Maybe" ? "selected" : null)">Pendiente</option>
            <option value="No" selected="@(currentStr == "No" ? "selected" : null)">No</option>
            </select>

                  <button type="submit" class="btn-sm">Guardar</button>
                </form>
              </li>
          }
        </ul>
      }
    </aside>

    <!-- Calendario -->
    <section class="panel-right">
      <h2 class="section-title">Calendario</h2>
      <div id="calendar"></div>
    </section>
  </div>
</section>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const calendarEl = document.getElementById('calendar');
      if (!calendarEl) return;

      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        height: 'auto',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        events: function (info, success, fail) {
          const url = '@Url.Action("CalendarFeed", "MyEvents")';
          const params = new URLSearchParams({ start: info.startStr, end: info.endStr });
          fetch(url + '?' + params, { credentials: 'include' })
            .then(r => r.json())
            .then(data => success(data))
            .catch(fail);
        },
        eventDidMount: function (info) {
          const loc = info.event.extendedProps?.location;
          if (loc) info.el.setAttribute('title', loc);
        },
        eventClick: function (info) {
          if (info.event.url) {
            window.location.href = info.event.url;
            info.jsEvent.preventDefault();
          }
        }
      });

      calendar.render();
    });
  </script>
}

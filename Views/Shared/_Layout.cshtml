@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var currentCulture = CultureInfo.CurrentUICulture;
    var normalizedCultureName = LocalizationSettings.NormalizeCultureName(currentCulture.Name);
    CultureInfo normalizedCulture;
    try
    {
        normalizedCulture = CultureInfo.GetCultureInfo(normalizedCultureName);
    }
    catch (CultureNotFoundException)
    {
        normalizedCulture = CultureInfo.CurrentUICulture;
        normalizedCultureName = normalizedCulture.Name;
    }

    var htmlLanguage = LocalizationSettings.GetHtmlLanguageTag(normalizedCulture);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@htmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (ViewData["Title"] is string pageTitle && !string.IsNullOrWhiteSpace(pageTitle))
        {
            @($"{pageTitle} - {Localizer["SiteName"].Value}")
        }
        else
        {
            @Localizer["SiteName"].Value
        }
    </title>

    <meta name="description" content="@Localizer["MetaDescription"].Value">
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@(ViewData["BodyClass"] ?? string.Empty)">
    <div id="site-bg" class="site-bg" aria-hidden="true"></div>

    <div id="intro" class="intro" role="dialog" aria-label="@Localizer["IntroAriaLabel"].Value" aria-modal="true">
        <div class="intro__scrim"></div>
        <div class="intro__media" aria-hidden="true"></div>

        <div class="intro__content">
            <h1>@Localizer["IntroHeading"].Value</h1>
            <p class="lead">@Localizer["IntroLead"].Value</p>
            <button id="intro-enter" class="btn">@Localizer["IntroButton"].Value</button>
        </div>
    </div>

    <header class="nav">
        <div class="container nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index" style="display:flex; align-items:center; gap:1px;">
                <img src="~/img/Inicio/logo_horizontal-diaples.gif"
                     alt="@Localizer["BrandAltText"].Value"
                     style="height:50px; width:auto; border-radius:8px;" />
            </a>

            <input id="nav-toggle" type="checkbox" class="nav-toggle" />
            <label for="nav-toggle" class="hamburger" aria-label="@Localizer["OpenMenuLabel"].Value">
                <span></span><span></span><span></span>
            </label>

            <nav class="nav-menu">
                <div class="nav-links">
                    <a asp-controller="Home" asp-action="About">@Localizer["NavAbout"].Value</a>
                    <a asp-controller="Home" asp-action="Espectaculos">@Localizer["NavShows"].Value</a>
                    <a asp-controller="Home" asp-action="Galeria">@Localizer["NavGallery"].Value</a>
                    <a asp-controller="Home" asp-action="Contact">@Localizer["NavContact"].Value</a>
                </div>

                <div class="nav-actions">
                    <form asp-controller="Localization" asp-action="SetLanguage" method="post" class="language-switcher">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <select id="culture-select" name="culture" onchange="this.form.submit()" aria-label="@Localizer["LanguageSelectorLabel"].Value">
                            <option value="es" selected="@(string.Equals(normalizedCultureName, "es", System.StringComparison.OrdinalIgnoreCase))">@Localizer["LanguageSpanish"].Value</option>
                            <option value="an" selected="@(string.Equals(normalizedCultureName, "an", System.StringComparison.OrdinalIgnoreCase))">@Localizer["LanguageAragonese"].Value</option>
                            <option value="en" selected="@(string.Equals(normalizedCultureName, "en", System.StringComparison.OrdinalIgnoreCase))">@Localizer["LanguageEnglish"].Value</option>
                        </select>
                    </form>
                    <partial name="_LoginPartial" />
                </div>

                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                {
                    <a href="~/Admin/Dashboard" class="btn btn-gradient">@Localizer["AdminLink"].Value</a>
                }
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("User"))
                {
                    <a href="~/MyEvents" class="btn btn-gradient">@Localizer["EventsLink"].Value</a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="content page-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container foot">
            <div>
                <div class="brand" style="display:flex; align-items:center; gap:12px;">
                    <img src="~/img/Inicio/wwwdiapleses.png"
                         alt="@Localizer["FooterBrandAltText"].Value"
                         style="height:48px; width:auto; border-radius:8px;" />
                </div>
                <p style="margin-top:12px; color:var(--muted); line-height:1.6;">
                    @Localizer["FooterDescription"].Value
                </p>

                <p style="margin-top:16px;">
                    📍 @Localizer["FooterAddress"].Value<br />
                    📞 <a href="tel:+34656813706" style="color:var(--txt);">+34 656 813 706</a><br />
                    ✉️ <a href="mailto:diaples@diaples.es" style="color:var(--txt);">diaples@diaples.es</a>
                </p>
            </div>

            <div>
                <h4>@Localizer["FooterContentHeading"].Value</h4>
                <a asp-controller="Home" asp-action="About">@Localizer["NavAbout"].Value</a><br />
                <a asp-controller="Home" asp-action="Espectaculos">@Localizer["NavShows"].Value</a><br />
                <a asp-controller="Home" asp-action="Galeria">@Localizer["NavGallery"].Value</a><br />
                <a asp-controller="Home" asp-action="Contact">@Localizer["NavContact"].Value</a>

                <div style="margin-top:18px; display:flex; gap:12px;">
                    <a href="https://es-es.facebook.com/osdiaples/" target="_blank" class="social-icon" aria-label="@Localizer["FacebookLabel"].Value">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://x.com/diaplesdauerba" target="_blank" class="social-icon" aria-label="@Localizer["TwitterLabel"].Value">
                        <i class="fab fa-twitter"></i>
                    </a>
                </div>
            </div>
        </div>

        <div style="margin-top:32px; text-align:center; font-size:0.9rem; color:var(--muted);">
            © @DateTime.Now.Year · @Localizer["SiteName"].Value · @Localizer["FooterRights"].Value · <a href="https://diaples.es" style="color:var(--brand);">www.diaples.es</a>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)

    <script>
    (function () {
      const SHOW_ONCE_PER_SESSION = true;
      const INTRO_KEY = "diaplesIntroSeen";
      const intro = document.getElementById('intro');
      const enterBtn = document.getElementById('intro-enter');
      const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function closeIntro() {
        if (!intro) return;
        intro.classList.add('is-hiding');
        setTimeout(() => {
          intro.remove();
          document.body.classList.remove('is-intro-lock');
        }, 400);
        if (SHOW_ONCE_PER_SESSION) sessionStorage.setItem(INTRO_KEY, '1');
      }

      if (prefersReduced) {
        intro?.remove();
        return;
      }

      if (SHOW_ONCE_PER_SESSION && sessionStorage.getItem(INTRO_KEY) === '1') {
        intro?.remove();
        return;
      }

      document.body.classList.add('is-intro-lock');

      enterBtn?.addEventListener('click', closeIntro);
      setTimeout(closeIntro, 5000);
    })();
    </script>
    <button id="btn-top" title="@Localizer["BackToTop"].Value">
      ↑
    </button>

    <script>
      const btnTop = document.getElementById("btn-top");

      window.addEventListener("scroll", () => {
        if (window.scrollY > 300) {
          btnTop.style.display = "flex";
        } else {
          btnTop.style.display = "none";
        }
      });

      btnTop.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>

    <script>
    document.addEventListener("DOMContentLoaded", () => {
      const introMedia = document.querySelector(".intro__media");
      if (!introMedia) return;
      const gifURL = "/img/Inicio/fondoDiaples.gif";

      const preload = new Image();
      preload.src = gifURL;

      preload.onload = () => {
        introMedia.style.backgroundImage = `url('${gifURL}')`;

        introMedia.style.transition = "filter 0.3s ease";
        introMedia.style.filter = "blur(6px) brightness(0.55)";
      };
    });
    </script>
</body>
</html>

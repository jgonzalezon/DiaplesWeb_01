@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@inject IViewLocalizer Localizer
@inject IOptions<RequestLocalizationOptions> LocalizationOptions
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var requestCulture = requestCultureFeature?.RequestCulture ?? new RequestCulture("es-ES");
    var supportedCultures = LocalizationOptions.Value.SupportedUICultures ?? Array.Empty<CultureInfo>();
    var currentCulture = CultureInfo.CurrentUICulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["SiteTitleSuffix"]</title>

    <meta name="description" content="@Localizer["MetaDescription"]">
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>


<body class="@(ViewData["BodyClass"] ?? "")">


    <!-- Fondo fijo para toda la web (quedará después del intro) -->
    <div id="site-bg" class="site-bg" aria-hidden="true"></div>

    <!-- Overlay de introducción (solo 1ª vez por sesión) -->
    <div id="intro" class="intro" role="dialog" aria-label="@Localizer["IntroDialogLabel"]" aria-modal="true">
      <div class="intro__scrim"></div>
      <div class="intro__media" aria-hidden="true"></div>

      <div class="intro__content">
        <h1>@Localizer["IntroTitle"]</h1>
        <p class="lead">@Localizer["IntroLead"]</p>
        <button id="intro-enter" class="btn">@Localizer["IntroEnter"]</button>
      </div>
    </div>

    <header class="nav">
    <div class="container nav-wrap">
        <a class="brand" asp-controller="Home" asp-action="Index" style="display:flex; align-items:center; gap:1px;">
        <img src="~/img/Inicio/logo_horizontal-diaples.gif"
            alt="Logo Os Diaples d'a Uerba"
            style="height:50px; width:auto; border-radius:8px;" />
        </a>

        <!-- Toggle móvil -->
        <input id="nav-toggle" type="checkbox" class="nav-toggle" />
        <label for="nav-toggle" class="hamburger" aria-label="@Localizer["HamburgerLabel"]">
        <span></span><span></span><span></span>
        </label>

        <!-- Menú -->
        <nav class="nav-menu">
        <div class="nav-links">
            <a asp-controller="Home" asp-action="About">@Localizer["MenuAbout"]</a>
            <a asp-controller="Home" asp-action="Espectaculos">@Localizer["MenuShows"]</a>
            <a asp-controller="Home" asp-action="Galeria">@Localizer["MenuGallery"]</a>
            <a asp-controller="Home" asp-action="Contact">@Localizer["MenuContact"]</a>
        </div>

        <!-- Acciones (login/registro/logout) -->
        <div class="nav-actions">
            <partial name="_LoginPartial" />
        </div>
        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
        {
            <a href="~/Admin/Dashboard" class="btn btn-gradient">@Localizer["AdminButton"]</a>
        }
        @if (SignInManager.IsSignedIn(User) && User.IsInRole("User"))
        {
            <a href="~/MyEvents" class="btn btn-gradient">@Localizer["EventsButton"]</a>
        }
        <div class="nav-language">
            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="language-form" aria-label="@Localizer["LanguageSelectorAria"]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label class="sr-only" for="culture-selector">@Localizer["LanguageSelectorLabel"]</label>
                <select id="culture-selector" name="culture" onchange="this.form.submit()" class="language-select" aria-label="@Localizer["LanguageSelectorAria"]">
                    @foreach (var culture in supportedCultures)
                    {
                        var isSelected = string.Equals(culture.Name, requestCulture.UICulture.Name, System.StringComparison.OrdinalIgnoreCase);
                        <option value="@culture.Name" @(isSelected ? "selected" : string.Empty)>@Localizer[$"LanguageOption_{culture.Name}"]</option>
                    }
                </select>
            </form>
        </div>
        </nav>
    </div>
    </header>


    <main role="main" class="content page-content">
        @RenderBody()
    </main>

<footer class="footer">
    <div class="container foot">
        <!-- Columna 1: Identidad -->
        <div>
            <div class="brand" style="display:flex; align-items:center; gap:12px;">
                <img src="~/img/Inicio/wwwdiapleses.png"
                     alt="Logo Diaples.es"
                     style="height:48px; width:auto; border-radius:8px;" />
            </div>
            <p style="margin-top:12px; color:var(--muted); line-height:1.6;">
                @Localizer["FooterAbout"]
            </p>

            <p style="margin-top:16px;">
                @Html.Raw(Localizer["FooterContact"])
            </p>
        </div>

        <!-- Columna 2: Navegación -->
        <div>
            <h4>@Localizer["FooterHeadingContent"]</h4>
            <a asp-controller="Home" asp-action="About">@Localizer["MenuAbout"]</a><br />
            <a asp-controller="Home" asp-action="Espectaculos">@Localizer["MenuShows"]</a><br />
            <a asp-controller="Home" asp-action="Galeria">@Localizer["MenuGallery"]</a><br />
            <a asp-controller="Home" asp-action="Contact">@Localizer["MenuContact"]</a>

        <div style="margin-top:18px; display:flex; gap:12px;">
                <a href="https://es-es.facebook.com/osdiaples/" target="_blank" class="social-icon">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="https://x.com/diaplesdauerba" target="_blank" class="social-icon">
                    <i class="fab fa-twitter"></i>
                </a>
            </div>

        </div>



    </div>

    <div style="margin-top:32px; text-align:center; font-size:0.9rem; color:var(--muted);">
        @Localizer["FooterRights", DateTime.Now.Year]
    </div>
</footer>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)

<script>
(function () {
  const SHOW_ONCE_PER_SESSION = true;
  const INTRO_KEY = "diaplesIntroSeen";
  const intro = document.getElementById('intro');
  const enterBtn = document.getElementById('intro-enter');
  const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function closeIntro() {
    if (!intro) return;
    intro.classList.add('is-hiding');
    setTimeout(() => {
      intro.remove();
      document.body.classList.remove('is-intro-lock');
    }, 400);
    if (SHOW_ONCE_PER_SESSION) sessionStorage.setItem(INTRO_KEY, '1');
  }

  if (prefersReduced) {
    intro?.remove();
    return;
  }

  if (SHOW_ONCE_PER_SESSION && sessionStorage.getItem(INTRO_KEY) === '1') {
    intro?.remove();
    return;
  }

  document.body.classList.add('is-intro-lock');

  enterBtn?.addEventListener('click', closeIntro);
  setTimeout(closeIntro, 5000);
})();
</script>
<!-- Botón para volver arriba -->
<button id="btn-top" title="@Localizer["BackToTop"]">
  ↑
</button>

<script>
  // Mostrar el botón solo cuando se hace scroll
  const btnTop = document.getElementById("btn-top");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 300) {
      btnTop.style.display = "flex";
    } else {
      btnTop.style.display = "none";
    }
  });

  // Al hacer clic, subir suavemente
  btnTop.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const introMedia = document.querySelector(".intro__media");
  if (!introMedia) return;
  const gifURL = "/img/Inicio/fondoDiaples.gif";

  // Preload del GIF
  const preload = new Image();
  preload.src = gifURL;

  preload.onload = () => {
    // Reemplazar el fondo estático por el GIF una vez cargado
    introMedia.style.backgroundImage = `url('${gifURL}')`;

    // Añadir una ligera transición visual si quieres suavizarlo
    introMedia.style.transition = "filter 0.3s ease";
    introMedia.style.filter = "blur(6px) brightness(0.55)";
  };
});
</script>


</body>
</html>

@{
    ViewData["Title"] = Localizer["AboutTitle"].Value;
}

<section class="hero-compact">
    <div class="container">
        <h1 class="title-xl">@Localizer["AboutHeroHeading"]</h1>
        <p class="lead">
            @Localizer["AboutHeroLead"]
        </p>
        <blockquote class="highlight">@Localizer["AboutQuote"]</blockquote>
    </div>
</section>

<section>
    <div class="container">
        <div class="media-grid">
            <article class="media-card" style="text-align:center;">
                <h2 class="section-title">@Localizer["AboutPhotoHeading"]</h2>
                <p class="section-sub">@Localizer["AboutPhotoSubheading"]</p>

                <figure style="margin:16px auto; max-width:800px;">
                    <img src="~/img/OsDiaples/Diables-lonyar_Diaples_pilares2016-5318.jpg"
                         alt="@Localizer["AboutPhotoAlt"]"
                         style="width:100%; height:auto; border-radius:var(--radius); border:1px solid var(--border); object-fit:cover;" />
                    <figcaption style="margin-top:8px; font-size:0.9rem; color:var(--muted);">
                        @Localizer["AboutPhotoCaption"]
                    </figcaption>
                </figure>
            </article>
        </div>

        <p>@Localizer["AboutVolunteerParagraph"]</p>
        <p>@Localizer["AboutIdentityParagraph"]</p>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutWhatAreDiaplesHeading"]</h2>
        <p>@Localizer["AboutWhatAreDiaplesParagraph1"]</p>
        <p>@Localizer["AboutWhatAreDiaplesParagraph2"]</p>
        <h3 class="section-title" style="font-size:1.5rem">@Localizer["AboutOtherBeingsHeading"]</h3>
        <ul class="feature-grid myth-grid">
            <li class="myth-card">
                <h4>@Localizer["AboutMythDiaplerons"]</h4>
                <p>@Html.Raw(Localizer["AboutMythDiapleronsDescription"])</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythBruxas"]</h4>
                <p>@Localizer["AboutMythBruxasDescription"]</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythEncantarias"]</h4>
                <p>@Localizer["AboutMythEncantariasDescription"]</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythFadas"]</h4>
                <p>@Localizer["AboutMythFadasDescription"]</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythChigans"]</h4>
                <p>@Localizer["AboutMythChigansDescription"]</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythOmes"]</h4>
                <p>@Localizer["AboutMythOmesDescription"]</p>
            </li>

            <li class="myth-card myth-card--wide">
                <h4>@Localizer["AboutMythLacuerco"]</h4>
                <p>@Localizer["AboutMythLacuercoDescription"]</p>
            </li>
        </ul>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutHistoryHeading"]</h2>
        <p>@Localizer["AboutHistoryParagraph1"]</p>
        <p>@Localizer["AboutHistoryParagraph2"]</p>
        <p>@Localizer["AboutHistoryParagraph3"]</p>
        <p>@Localizer["AboutHistoryParagraph4"]</p>
        <p>@Localizer["AboutHistoryParagraph5"]</p>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutGroupsHeading"]</h2>
        <div class="groups-grid">
            <article class="groups-card">
                <h3>@Localizer["AboutGroupsAragon"]</h3>
                <ul class="group-list">
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem1"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem2"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem3"])</li>
                    <li>@Localizer["AboutGroupsAragonItem4"]</li>
                    <li>@Localizer["AboutGroupsAragonItem5"]</li>
                    <li>@Localizer["AboutGroupsAragonItem6"]</li>
                </ul>
            </article>

            <article class="groups-card">
                <h3>@Localizer["AboutGroupsBeyond"]</h3>
                <ul class="group-list">
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem1"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem2"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem3"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem4"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem5"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem6"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem7"])</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem8"])</li>
                </ul>
            </article>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = Localizer["AboutTitle"].Value;
}

<section class="hero-compact">
    <div class="container">
        <h1 class="title-xl">@Localizer["AboutHeroHeading"].Value</h1>
        <p class="lead">
            @Localizer["AboutHeroLead"].Value
        </p>
        <blockquote class="highlight">@Localizer["AboutQuote"].Value</blockquote>
    </div>
</section>

<section>
    <div class="container">
        <div class="media-grid">
            <article class="media-card" style="text-align:center;">
                <h2 class="section-title">@Localizer["AboutPhotoHeading"].Value</h2>
                <p class="section-sub">@Localizer["AboutPhotoSubheading"].Value</p>

                <figure style="margin:16px auto; max-width:800px;">
                    <img src="~/img/OsDiaples/Diables-lonyar_Diaples_pilares2016-5318.jpg"
                         alt="@Localizer["AboutPhotoAlt"].Value"
                         style="width:100%; height:auto; border-radius:var(--radius); border:1px solid var(--border); object-fit:cover;" />
                    <figcaption style="margin-top:8px; font-size:0.9rem; color:var(--muted);">
                        @Localizer["AboutPhotoCaption"].Value
                    </figcaption>
                </figure>
            </article>
        </div>

        <p>@Localizer["AboutVolunteerParagraph"].Value</p>
        <p>@Localizer["AboutIdentityParagraph"].Value</p>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutWhatAreDiaplesHeading"].Value</h2>
        <p>@Localizer["AboutWhatAreDiaplesParagraph1"].Value</p>
        <p>@Localizer["AboutWhatAreDiaplesParagraph2"].Value</p>
        <h3 class="section-title" style="font-size:1.5rem">@Localizer["AboutOtherBeingsHeading"].Value</h3>
        <ul class="feature-grid myth-grid">
            <li class="myth-card">
                <h4>@Localizer["AboutMythDiaplerons"].Value</h4>
                <p>@Html.Raw(Localizer["AboutMythDiapleronsDescription"].Value)</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythBruxas"].Value</h4>
                <p>@Localizer["AboutMythBruxasDescription"].Value</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythEncantarias"].Value</h4>
                <p>@Localizer["AboutMythEncantariasDescription"].Value</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythFadas"].Value</h4>
                <p>@Localizer["AboutMythFadasDescription"].Value</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythChigans"].Value</h4>
                <p>@Localizer["AboutMythChigansDescription"].Value</p>
            </li>

            <li class="myth-card">
                <h4>@Localizer["AboutMythOmes"].Value</h4>
                <p>@Localizer["AboutMythOmesDescription"].Value</p>
            </li>

            <li class="myth-card myth-card--wide">
                <h4>@Localizer["AboutMythLacuerco"].Value</h4>
                <p>@Localizer["AboutMythLacuercoDescription"].Value</p>
            </li>
        </ul>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutHistoryHeading"].Value</h2>
        <p>@Localizer["AboutHistoryParagraph1"].Value</p>
        <p>@Localizer["AboutHistoryParagraph2"].Value</p>
        <p>@Localizer["AboutHistoryParagraph3"].Value</p>
        <p>@Localizer["AboutHistoryParagraph4"].Value</p>
        <p>@Localizer["AboutHistoryParagraph5"].Value</p>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["AboutGroupsHeading"].Value</h2>
        <div class="groups-grid">
            <article class="groups-card">
                <h3>@Localizer["AboutGroupsAragon"].Value</h3>
                <ul class="group-list">
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem1"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem2"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsAragonItem3"].Value)</li>
                    <li>@Localizer["AboutGroupsAragonItem4"].Value</li>
                    <li>@Localizer["AboutGroupsAragonItem5"].Value</li>
                    <li>@Localizer["AboutGroupsAragonItem6"].Value</li>
                </ul>
            </article>

            <article class="groups-card">
                <h3>@Localizer["AboutGroupsBeyond"].Value</h3>
                <ul class="group-list">
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem1"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem2"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem3"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem4"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem5"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem6"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem7"].Value)</li>
                    <li>@Html.Raw(Localizer["AboutGroupsBeyondItem8"].Value)</li>
                </ul>
            </article>
        </div>
    </div>
</section>

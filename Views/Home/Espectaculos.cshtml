@{
    ViewData["Title"] = Localizer["ShowsPageTitle"];
}

<section class="hero-compact">
    <div class="container">
        <h1 class="title-xl">@Localizer["ShowsHeroHeading"]</h1>
        <p class="lead">
            @Localizer["ShowsHeroLead"]
        </p>
    </div>
</section>

<section>
    <div class="container">
        <p>
            @Localizer["ShowsIntro"]
        </p>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Tardienta-2015-cascada.jpg"
                 alt="@Localizer["ShowsCascadeAlt"]"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsCascadeCaption"]
            </figcaption>
        </figure>
    </div>
</section>

<section>
    <div class="container">
        <div class="media-grid">
            <article class="media-card">
                <h2 class="section-title">@Localizer["ShowsLargeTitle"]</h2>
                <p class="section-sub">@Localizer["ShowsLargeSubtitle"]</p>
                <p>
                    @Localizer["ShowsLargeDescription"]
                </p>
            </article>
            <article class="media-card">
                <h2 class="section-title">@Localizer["ShowsSmallTitle"]</h2>
                <p class="section-sub">@Localizer["ShowsSmallSubtitle"]</p>
                <p>
                    @Localizer["ShowsSmallDescription"]
                </p>
            </article>
        </div>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Trasmoz-2014-publico.jpg"
                 alt="@Localizer["ShowsTrasmozAlt"]"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsTrasmozCaption"]
            </figcaption>
        </figure>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["ShowsAdaptHeading"]</h2>
        <p>
            @Localizer["ShowsAdaptDescription"]
        </p>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Medieval-Zaragoza-apg1375.jpg"
                 alt="@Localizer["ShowsMarketAlt"]"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsMarketCaption"]
            </figcaption>
        </figure>
    </div>
</section>

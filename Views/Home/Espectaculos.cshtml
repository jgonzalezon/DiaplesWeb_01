@{
    ViewData["Title"] = Localizer["ShowsPageTitle"].Value;
}

<section class="hero-compact">
    <div class="container">
        <h1 class="title-xl">@Localizer["ShowsHeroHeading"].Value</h1>
        <p class="lead">
            @Localizer["ShowsHeroLead"].Value
        </p>
    </div>
</section>

<section>
    <div class="container">
        <p>
            @Localizer["ShowsIntro"].Value
        </p>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Tardienta-2015-cascada.jpg"
                 alt="@Localizer["ShowsCascadeAlt"].Value"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsCascadeCaption"].Value
            </figcaption>
        </figure>
    </div>
</section>

<section>
    <div class="container">
        <div class="media-grid">
            <article class="media-card">
                <h2 class="section-title">@Localizer["ShowsLargeTitle"].Value</h2>
                <p class="section-sub">@Localizer["ShowsLargeSubtitle"].Value</p>
                <p>
                    @Localizer["ShowsLargeDescription"].Value
                </p>
            </article>
            <article class="media-card">
                <h2 class="section-title">@Localizer["ShowsSmallTitle"].Value</h2>
                <p class="section-sub">@Localizer["ShowsSmallSubtitle"].Value</p>
                <p>
                    @Localizer["ShowsSmallDescription"].Value
                </p>
            </article>
        </div>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Trasmoz-2014-publico.jpg"
                 alt="@Localizer["ShowsTrasmozAlt"].Value"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsTrasmozCaption"].Value
            </figcaption>
        </figure>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-title">@Localizer["ShowsAdaptHeading"].Value</h2>
        <p>
            @Localizer["ShowsAdaptDescription"].Value
        </p>

        <figure class="media-card" style="margin-top:16px; text-align:center;">
            <img src="~/img/Espectaculos/Medieval-Zaragoza-apg1375.jpg"
                 alt="@Localizer["ShowsMarketAlt"].Value"
                 style="width:100%; height:auto; max-height:480px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:12px; font-size:0.95rem; color:var(--muted);">
                @Localizer["ShowsMarketCaption"].Value
            </figcaption>
        </figure>
    </div>
</section>

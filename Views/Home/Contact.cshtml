@model DiaplesWeb.Models.ContactViewModel
@{
    ViewData["Title"] = Localizer["ContactTitle"];
    ViewData["BodyClass"] = "page-contact";
}

<div class="container contact-page">
    <header class="section-head">
        <h2 class="section-title">@Localizer["ContactHeading"]</h2>
        <p class="section-sub">@Localizer["ContactSubheading"]</p>
        @if (TempData["ContactOk"] is string ok)
        {
            <div class="alert-success">@ok</div>
        }
    </header>

    <div class="contact-layout">
        <aside class="contact-card">
            <h3 class="contact-card__title">@Html.Raw(Localizer["ContactCardTitle"])</h3>
            <p class="contact-card__text">@Html.Raw(Localizer["ContactCardAddress"])</p>
            <p class="contact-card__text">
                <strong>@Localizer["ContactPhoneLabel"]</strong> <a href="tel:+34656813706">+34 656 813 706</a><br />
                <strong>@Localizer["ContactEmailLabel"]</strong> <a href="mailto:diaples@diaples.es">diaples@diaples.es</a><br />
                <strong>@Localizer["ContactWebLabel"]</strong> <a href="https://www.diaples.es" target="_blank" rel="noopener">www.diaples.es</a>
            </p>
            <div class="contact-card__social">
                <a href="https://es-es.facebook.com/osdiaples/" target="_blank" rel="noopener noreferrer" class="chip">Facebook</a>
                <a href="https://www.youtube.com/user/osdiaplesdauerba" target="_blank" rel="noopener noreferrer" class="chip">YouTube</a>
            </div>
            <p class="contact-card__hint">@Localizer["ContactHint"]</p>
        </aside>

        <div class="form-card">
            <form asp-action="Contact" method="post" class="form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="val-summary"></div>

                <div class="form-grid">
                    <div class="form-field">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="input" placeholder="@Localizer["ContactNamePlaceholder"]" />
                        <span asp-validation-for="Name" class="val-msg"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="input" placeholder="@Localizer["ContactEmailPlaceholder"]" />
                        <span asp-validation-for="Email" class="val-msg"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" class="input" placeholder="@Localizer["ContactPhonePlaceholder"]" />
                        <span asp-validation-for="Phone" class="val-msg"></span>
                    </div>

                    <div class="form-field form-field--full">
                        <label asp-for="Message"></label>
                        <textarea asp-for="Message" class="input" rows="5" placeholder="@Localizer["ContactMessagePlaceholder"]"></textarea>
                        <span asp-validation-for="Message" class="val-msg"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn" type="submit">@Localizer["ContactSubmit"]</button>
                </div>
            </form>
        </div>
    </div>

    <p class="contact-footnote">
        @Localizer["ContactFootnote"]
    </p>
</div>

@section Styles {
<style>
  /* ——— Ampliar y centrar SOLO en la vista de Contacto ——— */
  .page-contact .page-content {
    max-width: 1200px !important;
    width: min(92vw, 1200px) !important;
    margin-inline: auto !important;
    padding-inline: 0;
    position: relative;
  }

  /* Si el layout pinta un fondo oscuro, lo desactivamos aquí */
  .page-contact .page-content::before {
    content: none !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  /* Estilo de la tarjeta principal */
  .contact-page {
    max-width: 1100px;
    width: min(92vw, 1100px);
    margin-inline: auto;
    position: relative;
    padding: 24px;
  }
  .contact-page::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: rgba(12,16,22,.72);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,.04),
      0 12px 40px rgba(0,0,0,.45);
    z-index: 0;
  }
  .contact-page > * { position: relative; z-index: 1; }

  .contact-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
  }

  @@media (max-width: 900px) {
    .page-contact .page-content,
    .contact-page {
      width: 96vw;
      max-width: 96vw;
    }
    .contact-layout { grid-template-columns: 1fr; }
  }
</style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

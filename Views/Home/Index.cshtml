@{
    ViewData["Title"] = Localizer["IndexTitle"].Value;
}

<section class="hero">
    <div class="container" style="text-align:center">
        <h1>@Localizer["HeroMainHeading"]</h1>
        <p class="lead">@Localizer["HeroLeadText"]</p>

        <figure style="margin:32px auto 16px; max-width:420px">
            <img src="~/img/Inicio/logo_diaples.jpg"
                 alt="@Localizer["HeroLogoAlt"]"
                 style="width:100%; border-radius:var(--radius); border:1px solid var(--border);" />
            <figcaption style="margin-top:8px; font-size:0.9rem; color:var(--muted)">
                @Localizer["HeroFigureCaption"]
            </figcaption>
        </figure>

        <p>@Localizer["HeroDescription"]</p>
        <a class="btn" asp-controller="Home" asp-action="About" style="margin-top:24px; display:inline-block;">
            @Localizer["HeroCta"]
        </a>
    </div>
</section>

<section style="padding:60px 0">
    <div class="container" style="display:grid; gap:32px">
        <article class="card" style="padding:32px; border-radius:var(--radius); border:1px solid var(--border); background:var(--bg-2)">
            <h2>@Localizer["SpiritHeading"]</h2>
            <p>@Localizer["SpiritParagraph1"]</p>
            <p>@Localizer["SpiritParagraph2"]</p>
            <p>@Localizer["SpiritParagraph3"]</p>
        </article>

        <article class="card" style="padding:32px; border-radius:var(--radius); border:1px solid var(--border); background:var(--bg-2)">
            <h2>@Localizer["ShowsHeading"]</h2>
            <p>@Localizer["ShowsParagraph"]</p>
            <ul>
                <li>@Localizer["ShowsListLarge"]</li>
                <li>@Localizer["ShowsListSmall"]</li>
                <li>@Localizer["ShowsListStreet"]</li>
                <li>@Localizer["ShowsListAdapt"]</li>
            </ul>
            <p><a asp-controller="Home" asp-action="Contact">@Localizer["ShowsContactLink"]</a></p>
        </article>

        <article class="card" style="padding:32px; border-radius:var(--radius); border:1px solid var(--border); background:var(--bg-2)">
            <h2>@Localizer["FeaturedHeading"]</h2>
            <figure class="img-center">
                <img src="~/img/Inicio/Diables-lonyar_Diaples_pilares2016-5066.jpg"
                     alt="@Localizer["FeaturedImageAlt"]"
                     style="width:100%; max-height:340px; object-fit:cover; border-radius:var(--radius); border:1px solid var(--border);" />
                <figcaption>
                    @Localizer["FeaturedCaption"]
                </figcaption>
            </figure>
            <p>@Localizer["FeaturedDescription"]</p>
        </article>

        <article class="card" style="padding:32px; border-radius:var(--radius); border:1px solid var(--border); background:var(--bg-2)">
            <h2>@Localizer["LocationsHeading"]</h2>
            <p>@Localizer["LocationsParagraph"]</p>
            <div class="grid" style="display:grid; gap:16px">
                <div>
                    <h3 style="margin-bottom:8px">@Localizer["LocationsFestivals"]</h3>
                    <ul>
                        <li>@Html.Raw(Localizer["LocationsFestivalsItem1"])</li>
                        <li>@Html.Raw(Localizer["LocationsFestivalsItem2"])</li>
                        <li>@Html.Raw(Localizer["LocationsFestivalsItem3"])</li>
                        <li>@Html.Raw(Localizer["LocationsFestivalsItem4"])</li>
                        <li>@Html.Raw(Localizer["LocationsFestivalsItem5"])</li>
                    </ul>
                </div>
                <div>
                    <h3 style="margin-bottom:8px">@Localizer["LocationsTownFestivals"]</h3>
                    <ul>
                        <li>@Localizer["LocationsTownItem1"]</li>
                        <li>@Localizer["LocationsTownItem2"]</li>
                        <li>@Localizer["LocationsTownItem3"]</li>
                        <li>@Localizer["LocationsTownItem4"]</li>
                        <li>@Localizer["LocationsTownItem5"]</li>
                        <li>@Localizer["LocationsTownItem6"]</li>
                        <li>@Localizer["LocationsTownItem7"]</li>
                    </ul>
                </div>
                <div>
                    <h3 style="margin-bottom:8px">@Localizer["LocationsMarkets"]</h3>
                    <ul>
                        <li>@Localizer["LocationsMarketsItem1"]</li>
                        <li>@Localizer["LocationsMarketsItem2"]</li>
                        <li>@Localizer["LocationsMarketsItem3"]</li>
                    </ul>
                </div>
            </div>
            <p>@Localizer["LocationsClosing"]</p>
            <div class="map-container" style="margin: 24px 0;">
                <iframe
                    src="https://www.google.com/maps/d/embed?mid=1SfW-sLdo4DvtViYDgc_8UXBTno4&hl=es&z=6"
                    allowfullscreen
                    loading="lazy">
                </iframe>
            </div>

            <p><a asp-controller="Home" asp-action="Contact">@Localizer["LocationsContact"]</a></p>
        </article>
    </div>
</section>
